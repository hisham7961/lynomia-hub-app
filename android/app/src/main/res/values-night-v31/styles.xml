<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (SplashScreen API): خلفية العلامة وأيقونة التطبيق التكيّفية تلقائياً.
         السمة من AppCompat — شرط local_auth (راجع values/styles.xml). -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_primary</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_primary</item>
    </style>
</resources>
